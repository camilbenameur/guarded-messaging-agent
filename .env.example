# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Anthropic API key (optional: without it, vision and drafts use deterministic mocks)
ANTHROPIC_API_KEY=

# Model pins (overridable)
DRAFT_MODEL=claude-opus-4-8
CAPTION_MODEL=claude-sonnet-5

# Vision captioning volume guard
MAX_CAPTION_IMAGES=500

# faster-whisper model size for STT
WHISPER_MODEL=small

# Kill switch: set to 1 (or true/yes/on) to refuse ALL sends —
# auto-policy passes AND human-approved releases alike, regardless of any
# per-chat policy. Queued sends stay pending and can be released after the
# switch is cleared. Leave empty for normal gated operation.
SEND_KILL_SWITCH=

# Optional: point the console approval path (`python -m mcp_server.approve`)
# at a FakeBridge scenario file for demos/manual testing, e.g.
# /app/tests/fixtures/scenario.json inside the mcp container. With neither
# this nor the real bridge configured, releasing a queued send is
# refused fail-closed (the row stays pending).
BRIDGE_SCENARIO=
